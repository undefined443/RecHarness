# Copy to .env and fill in real values. Never commit .env itself.

# Default LLM provider (llm_provider="openai"): any OpenAI-compatible gateway,
# read natively by langchain_openai.ChatOpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: talk to VolcEngine Ark directly instead (llm_provider="volcengine").
VOLCENGINE_API_KEY=
# ARK_API_KEY=          # alias for VOLCENGINE_API_KEY, either works
# VOLCENGINE_BASE_URL=  # override, defaults to https://ark.cn-beijing.volces.com/api/v3

# Optional: Claude instead of the default provider (llm_provider="anthropic").
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing. Tracing is skipped when this is empty.
LANGSMITH_API_KEY=

# Optional: only needed to download raw competition data for the
# spooky_author MLE-Bench Lite benchmark (prepare_spooky_data.py).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
